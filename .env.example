# Server-only environment variables for Team Tetris Exoplanet Explorer
# Copy this file to .env.local and fill in FEATHERLESS_API_KEY yourself.
# NEVER put secrets in VITE_* variables or commit .env.local to Git.

FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen3-14B
FEATHERLESS_FALLBACK_MODEL=Qwen/Qwen3-8B
HELM_MAX_INFLIGHT=2
HELM_QUEUE_WAIT_MS=8000
HELM_RATE_LIMIT_PER_MIN=20
SNAPSHOT_ID=

