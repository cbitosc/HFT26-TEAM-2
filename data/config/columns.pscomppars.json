{
  "table": "pscomppars",
  "description": "Pinned column whitelist for NASA Exoplanet Archive pscomppars (Planetary Systems Composite Parameters, DOI 10.26133/NEA13). Verified against real CSV header (325 columns, 6,451 rows).",
